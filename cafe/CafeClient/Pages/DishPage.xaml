<Page x:Class="CafeClient.Pages.DishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="White"
      Title="Информация о блюде">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Column="0" HorizontalAlignment="Right"
                   VerticalAlignment="Stretch" Width="2" Fill="#EAEAEA" Margin="0,40,0,40" />

        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,30">
        
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="3"
                        CornerRadius="16"
                        Padding="15"
                        Background="White"
                        Margin="0,0,0,10">
                    <Image x:Name="DishImage" Stretch="Uniform" Width="370" Height="250" />
                </Border>

                <Button x:Name="ButtonImage" 
                        Content="Добавить фото" 
                        Width="300" 
                        Height="45"
                        Click="ButtonBase_OnClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel> 
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="30,0,30,20">
                <StackPanel>

                    <TextBlock Text="ОПИСАНИЕ" FontSize="14" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding Description}" FontSize="18" TextWrapping="Wrap" Foreground="#444444"
                               Margin="0,0,0,25" LineHeight="24" />

                    <TextBlock Text="СОСТАВ БЛЮДА" FontSize="14" FontWeight="Bold" Foreground="#AAAAAA"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Ingredients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <Grid>
                                        <TextBlock Text="{Binding IngredientName}" FontSize="18" FontWeight="Medium"
                                                   HorizontalAlignment="Left" Foreground="#333333" />

                                        <TextBlock FontSize="18" HorizontalAlignment="Right" Foreground="#777777">
                                            <Run Text="{Binding Amount, StringFormat={}{0:0.##}}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Unit}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1" Margin="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding Category, Mode=OneWay}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     IsReadOnly="True"
                     FontSize="18"
                     Margin="0,0,0,20"
                     materialDesign:HintAssist.Hint="Категория"
                     materialDesign:HintAssist.IsFloating="True" />

            <TextBox Grid.Row="1"
                     Text="{Binding Name, Mode=OneWay}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     IsReadOnly="True"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Margin="0,0,0,20"
                     materialDesign:HintAssist.Hint="Название блюда"
                     materialDesign:HintAssist.IsFloating="True" />

            <Border Grid.Row="2" Background="#F1F8E9" BorderBrush="#C5E1A5" BorderThickness="1" CornerRadius="8"
                    Padding="15,10" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#4CAF50" Width="24" Height="24"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Доступно для заказа" Foreground="#2E7D32" FontSize="16" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <TextBox Grid.Row="4"
                     Text="{Binding Price, StringFormat={}{0:0.##} ₽, Mode=OneWay}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     IsReadOnly="True"
                     FontSize="36"
                     FontWeight="Bold"
                     Foreground="#4CAF50"
                     Margin="0,0,0,30"
                     materialDesign:HintAssist.Hint="Стоимость"
                     materialDesign:HintAssist.IsFloating="True" />

            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Button Content="НАЗАД"
                        Click="BackButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        FontSize="18"
                        Height="50"
                        materialDesign:ButtonAssist.CornerRadius="5" />
            </Grid>
        </Grid>
    </Grid>
</Page>