<Page x:Class="CafeClient.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="#FAFAFA"
      Title="Главное меню"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Height="60" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" VerticalContentAlignment="Center" FontSize="17" Padding="10" Margin="5"
                     materialDesign:HintAssist.Hint="Поиск по меню..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" TextChanged="TextBox_TextChanged" />

            <Button Grid.Column="1" Height="40" Margin="5" Content="Создать заказ" Click="CreateOrder_Click" />
            <Button Grid.Column="2" Height="40" Margin="5" Content="Обновить" Click="RefreshButton_Click" />

            <materialDesign:PopupBox Grid.Column="3"
                                     Width="150"
                                     Height="40"
                                     Margin="5"
                                     PlacementMode="BottomAndAlignCentres"
                                     StaysOpen="False">

                <materialDesign:PopupBox.ToggleContent>
                    <Border Background="#673AB7" Width="150" Height="40">

                        <TextBlock Text="Действия ▾"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                    </Border>
                </materialDesign:PopupBox.ToggleContent>

                <StackPanel Width="180">
                    <Button x:Name="ButtonMenu"
                            Content="Управление меню"
                            Click="AddMenu_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" />

                    <Button x:Name="ButtonUser"
                            Content="Пользователи"
                            Click="Button_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" />

                    <Separator Margin="10,5" />
                    <Button x:Name="DownloadDocument"
                            Content="Отчет (Excel)"
                            Click="Button_Click_ExcelAsync"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Green" />
                </StackPanel>
            </materialDesign:PopupBox>

            <Button x:Name="ButtonKitchen" Grid.Column="5" Height="40" Margin="5" Content="Экран кухни"
                    Click="OpenKitchen_Click" />
            <Button Grid.Column="6" Height="40" Margin="5" Content="Выйти" Click="LogoutButton_Click"
                    Background="#D32F2F" BorderBrush="#D32F2F" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10">

            <TabControl Style="{StaticResource MaterialDesignTabControl}">

                <TabItem Header="Активные" FontSize="14" FontWeight="SemiBold">
                    <ListView x:Name="OrdersListView"
                              Background="Transparent"
                              MouseDoubleClick="OrdersListView_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Padding="10" UniformCornerRadius="6" Width="185">
                                    <StackPanel>
                                        <TextBlock Margin="5" Text="{Binding TableNumber, StringFormat=Столик №{0}}"
                                                   FontWeight="Bold" FontSize="25" />
                                        <TextBlock Margin="5" Text="{Binding UserName}" FontSize="16"
                                                   FontWeight="SemiBold" Foreground="DimGray" />

                                        <TextBlock Text="{Binding Status}" FontSize="18" Foreground="#1976D2" />

                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="Добавлен:" Foreground="Green" />
                                            <Run Text="{Binding CreatedAt, StringFormat=HH:mm}" Foreground="Green"
                                                 FontWeight="Bold" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0} ₽}" FontWeight="Bold"
                                                   FontSize="16" Margin="0,10,0,0" />
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabItem>

                <TabItem Header="Архив" FontSize="16">
                    <ListView x:Name="HistoryListView"
                              BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="HistoryListView_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="5" Padding="15" UniformCornerRadius="6"
                                                     Background="#F5F5F5" Width="180">
                                    <StackPanel>
                                        <TextBlock Margin="5" Text="{Binding TableNumber, StringFormat=Столик №{0}}"
                                                   FontWeight="Bold" FontSize="23" Foreground="Gray" />
                                        <TextBlock Margin="5" Text="{Binding UserName}" FontSize="16" Foreground="Gray" />
                                        <TextBlock Margin="5" Text="{Binding Status}" FontSize="18" Foreground="Green"
                                                   FontWeight="Bold" />
                                        <TextBlock Margin="5" Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                   Foreground="Gray" />
                                        <TextBlock Margin="5" Text="{Binding TotalAmount, StringFormat={}{0} ₽}"
                                                   FontWeight="Bold" FontSize="16" Foreground="Gray" />
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Категории" HorizontalAlignment="Center" FontSize="30"
                           FontWeight="SemiBold" Margin="5" />
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <WrapPanel Margin="5" HorizontalAlignment="Center">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Height" Value="80"/>
                                <Setter Property="Width" Value="150"/>
                                <Setter Property="Margin" Value="6"/>
                                <Setter Property="FontSize" Value="20"/>
                            </Style>
                        </WrapPanel.Resources>

                        <Button Content="Супы" Tag="Супы" Click="CategoryButton_Click" />
                        <Button Content="Салаты" Tag="Салаты" Click="CategoryButton_Click" />
                        <Button Content="Закуски" Tag="Закуски" Click="CategoryButton_Click" />
                        <Button Content="Пицца" Tag="Пицца" Click="CategoryButton_Click" />
                        <Button Content="Паста" Tag="Паста" Click="CategoryButton_Click" />
                        <Button Content="Десерты" Tag="Десерты" Click="CategoryButton_Click" />
                        <Button Content="Напитки" Tag="Напитки" Click="CategoryButton_Click" />
                        <Button Content="Гарниры" Tag="Гарниры" Click="CategoryButton_Click" />
                        <Button Content="Соусы" Tag="Соусы" Click="CategoryButton_Click" />
                        <Button Content="СБРОСИТЬ" Click="ResetButton_Click" FontWeight="Bold" />
                    </WrapPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1" Text="Меню" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ListView Grid.Row="2" x:Name="MenuListView" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          MouseDoubleClick="MenuListView_MouseDoubleClick"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,5" UniformCornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Category}" FontSize="14" Foreground="Gray"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tags}" Margin="0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E3F2FD" CornerRadius="10" Padding="8,2"
                                                        Margin="0,2,5,2" BorderBrush="#BBDEFB" BorderThickness="1">
                                                    <TextBlock Text="{Binding TagName}" FontSize="11"
                                                               Foreground="#1976D2" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="15"
                                               TextWrapping="Wrap" Margin="0,8" Foreground="#444444" />

                                    <Grid Grid.Row="3" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" FontWeight="Bold"
                                                   Foreground="#2E7D32" FontSize="20" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                HorizontalAlignment="Right" Width="70" Height="50"
                                                Click="AddToCart_Click"
                                                ToolTip="Добавить в заказ">
                                            <materialDesign:PackIcon Kind="Plus" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</Page>